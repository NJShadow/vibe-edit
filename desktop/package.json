{
  "name": "vibe-edit",
  "productName": "Vibe Edit",
  "version": "4.10.5",
  "description": "Fast, free, offline video editor",
  "main": "main.js",
  "author": "Mike Hartnett",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.vibeedit.editor",
    "productName": "Vibe Edit",
    "files": [
      "main.js",
      "audio-filter.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "copyright": "Copyright (c) 2026 Mike Hartnett",
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "nsis": {
      "license": "../LICENSE"
    }
  }
}
